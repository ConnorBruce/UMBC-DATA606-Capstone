rf_stats
```

## XG Boost

#### Building Model
```{r}
Analysis_Dataset_xgb = Analysis_Data_noGeo %>%
  mutate(SURFACE_TYPE = as.factor(SURFACE_TYPE))

train_indices_xgb = createDataPartition(Analysis_Dataset_xgb$IRI_Delta,
                                    p = 0.8,
                                    list = FALSE)

train_set_xgb = Analysis_Dataset_xgb[train_indices_xgb,]
test_set_xgb = Analysis_Dataset_xgb[-train_indices_xgb,] 

xgb_matrix = data.matrix(train_set_xgb %>% select(-IRI_Delta))
xgb_label = train_set_xgb$IRI_Delta

# 2. Set parameters for regression
xgb_params = list(
  objective = "reg:squarederror",
  eval_metric = "rmse",
  learning_rate = 0.1,
  max_depth = 6
)

# 3. Train the model
xgb_model <- xgboost(
  data = xgb_matrix,
  label = xgb_label,
  params = xgb_params,
  nrounds = 100,
  verbose = 1
)

```

#### Testing Accuracy
```{r}
xgb_preds = predict(xgb_model, test_set_xgb %>%select(-IRI_Delta))
xgb_actuals = test_set_xgb$IRI_Delta

xgb_stats = postResample(pred = xgb_preds, obs = xgb_actuals) %>%
  as.data.frame() %>%
  rownames_to_column("Metric") %>%
  pivot_wider(names_from = "Metric", values_from = ".") %>%
  mutate(Model = "XG Boost") %>%
  select(Model, RMSE, Rsquared, MAE)
xgb_stats
```

