## Reading in Packages
```{r}
library(tidyverse)
library(caret)
library(randomForest)
library(leaflet)
library(sf)
library(reshape2)
library(xgboost)
```

## Load Analysis Dataset
```{r}
load("Analysis_Dataset.Rdata")
load("All_Condition_Data_Deltas.Rdata")

Analysis_Dataset = Analysis_Dataset %>%
  mutate(NHS = if_else(NHS == 0,0,1)) %>%
  mutate(F_SYSTEM = if_else(F_SYSTEM == 1,1,0))

All_Condition_Deltas_Filtered = All_Condition_Deltas_Filtered %>%
  mutate(NHS = if_else(NHS == 0,0,1)) %>%
  mutate(F_SYSTEM = if_else(F_SYSTEM == 1,1,0))

save(Analysis_Dataset, file = "Analysis_Dataset.Rdata")
save(All_Condition_Deltas_Filtered,file = "All_Condition_Data_Deltas.Rdata")

```

## Regression Model

#### Building Model
```{r}
Analysis_Data_noGeo = Analysis_Dataset %>%
  st_drop_geometry()

train_indices_reg = createDataPartition(Analysis_Data_noGeo$IRI_Delta,
                                    p = 0.8,
                                    list = FALSE)

train_set_reg = Analysis_Data_noGeo[train_indices_reg,]
test_set_reg = Analysis_Data_noGeo[-train_indices_reg,]

reg_model = lm(IRI_Delta ~ ., data = Analysis_Data_noGeo)

```

#### Testing Accuracy
```{r}
reg_preds = predict(reg_model, test_set_reg)
reg_actuals = test_set_reg$IRI_Delta

reg_stats = postResample(pred = reg_preds, obs = reg_actuals) %>%
  as.data.frame() %>%
  rownames_to_column("Metric") %>%
  pivot_wider(names_from = "Metric", values_from = ".") %>%
  mutate(Model = "Linear Regression") %>%
  select(Model, RMSE, Rsquared, MAE)
reg_stats
```

## Random Forest

#### Building Model
```{r}
Analysis_Data_noGeo = Analysis_Dataset %>%
  st_drop_geometry()

train_indices_rf = createDataPartition(Analysis_Data_noGeo$IRI_Delta,
                                    p = 0.8,
                                    list = FALSE)

train_set_rf = Analysis_Data_noGeo[train_indices_rf,]
test_set_rf = Analysis_Data_noGeo[-train_indices_rf,] 

rf_model = randomForest(IRI_Delta ~ .,data = train_set_rf, ntree = 50, importance = T)

```

#### Testing Accuracy
```{r}
rf_preds = predict(rf_model, test_set_rf)
rf_actuals = test_set_rf$IRI_Delta

rf_stats = postResample(pred = rf_preds, obs = rf_actuals) %>%
